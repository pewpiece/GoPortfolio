---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/content';
---
<BaseLayout title="Page not found" noindex>
  <div class="wrap not-found">
    <h1>This page isn't on the pegboard</h1>
    <p>The link may be old or mistyped. Try one of these instead.</p>
    <div class="btn-row">
      <a class="btn" href={url('/')}>Go to the home page</a>
      <a class="btn quiet" href={url('/#apps')}>See the apps</a>
    </div>
  </div>
</BaseLayout>
