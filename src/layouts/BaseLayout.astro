---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site, url } from '../lib/content';

interface Props { title?: string; description?: string; ogSlug?: string; noindex?: boolean; }
const { title, description = site.description, ogSlug = 'site', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(`/og/${ogSlug}.png`), Astro.site).href;
const path = Astro.url.pathname;
const navItems = [
  { href: url('/#apps'), label: 'Apps', match: '/apps/' },
  { href: url('/how-i-build/'), label: 'How I build', match: '/how-i-build/' },
  { href: url('/thanks/'), label: 'Thanks', match: '/thanks/' },
  { href: url('/credits/'), label: 'Credits', match: '/credits/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      /* Set the saved theme before first paint so there is no flash of the wrong one. */
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch { /* storage unavailable */ }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>{site.name}</a>
        <nav aria-label="Main">
          <ul class="nav">
            {navItems.map((n) => (
              <li><a href={n.href} aria-current={path.includes(n.match) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{site.footerThanks} See the <a href={url('/thanks/')}>thanks</a> and the <a href={url('/credits/')}>credits</a>.</p>
        <p>Code on <a href={site.links.github}>GitHub</a>. No cookies, no tracking.</p>
      </div>
    </footer>
  </body>
</html>
